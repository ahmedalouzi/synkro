# Synkro environment variables.
# Copy to `.env` (server, repo root) or `apps/desktop/.env` (desktop dev) and fill in.
# Never commit real values. Installed desktop builds do NOT read .env.

# ── Database (server + desktop dev) ──────────────────────────────────────────
# Local: `pnpm test:env:up` starts Postgres from docker-compose.test.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/peep_test
# Test suites only (packages/agent/tests); default to the local peep database.
DATABASE_URL_API=
DATABASE_URL_WORKER=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
# In production the AI keys come from AWS Secrets Manager (prod/synkro/backend-secrets).
AWS_REGION=us-east-1
# Crash reporting (server and desktop). Leave empty to disable.
SENTRY_DSN=

# ── AI providers ─────────────────────────────────────────────────────────────
GOOGLE_API_KEY=
# Older name for the same key; GOOGLE_API_KEY wins.
GOOGLE_GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Desktop app (dev only) ───────────────────────────────────────────────────
# Gateway the app talks to. Defaults to https://api.synkro.com.
SYNKRO_GATEWAY_URL=http://localhost:8080
# Use the in-process mock gateway instead of a server.
SYNKRO_USE_MOCK_GATEWAY=false
# Insert the dev@synkro.com user (Pro plan) into the local database on start.
SYNKRO_SEED_DEV_USER=false

# Baked into the renderer at build time (Vite).
# Website for pricing, account/billing and docs links.
VITE_SYNKRO_WEB_URL=
# true = real cloud build API, otherwise the mock build API.
VITE_USE_REAL_BUILD_API=false

# ── Cloud build worker ───────────────────────────────────────────────────────
# Where finished APKs are stored on the server disk (DEC-01). Default /var/lib/synkro/artifacts.
ARTIFACT_DIR=
# Mark a build successful with a placeholder URL when the artifact upload fails (tests only).
SYNKRO_ALLOW_MOCK_ARTIFACT=false
ANDROID_HOME=
ANDROID_SDK_ROOT=
# Encrypts every project's release signing key in the database (AES-256-GCM). 32 bytes, base64:
#   openssl rand -base64 32
# Required in production (the server will not start without it).
# WARNING: keep a copy OFF the server (e.g. the team password manager). If it is lost, every user's
# signing key is lost and their apps can no longer be updated on Google Play. Changing it needs every
# stored key re-encrypted first: never just replace it.
SYNKRO_SIGNING_ENC_KEY=

# MinIO / S3 artifact store (not used in the MVP, see DEC-01).
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
