{
  "name": "@peep/desktop",
  "version": "0.1.0",
  "private": true,
  "productName": "Synkro",
  "description": "Synkro desktop application",
  "author": "Synkro",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "publish:app": "electron-vite build && electron-builder --publish always",
    "build:win": "electron-vite build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@monaco-editor/react": "^4.7.0",
    "@peep/agent": "workspace:*",
    "@peep/flutter-adapter": "workspace:*",
    "@peep/platform-core": "workspace:*",
    "@peep/shared": "workspace:*",
    "@sentry/electron": "^7.16.0",
    "@sentry/react": "^10.73.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "0.15.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/xterm": "^5.5.0",
    "chokidar": "^4.0.3",
    "diff": "^7.0.0",
    "dotenv": "^17.4.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "emmet-monaco-es": "^5.7.0",
    "eventsource": "^5.1.2",
    "monaco-editor": "^0.52.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.7",
    "react-virtuoso": "^4.18.12",
    "remark-gfm": "^4.0.1",
    "simple-git": "^3.27.0",
    "ws": "8.21.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/diff": "^5.2.3",
    "@types/eventsource": "^3.0.0",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jsdom": "^30.0.1",
    "png2icons": "^2.0.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
