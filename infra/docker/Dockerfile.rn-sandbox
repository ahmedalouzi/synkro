# ==============================================================================
# Synkro React Native & Expo Android Build Sandbox
# Image Tag: synkro/rn-sandbox:1
# ==============================================================================

FROM reactnativecommunity/react-native-android@sha256:10ab6f44862b9fb9c1c64fb94566ce9f3c11f5a016f9061ef1a38f30a6bcc76f

USER root

# Setup environment matching Cloud Build sandbox runtime
ENV HOME=/tmp \
    GRADLE_USER_HOME=/tmp/.gradle \
    NPM_CONFIG_CACHE=/tmp/.npm-cache

# 1. Pre-warm the Gradle distributions the supported templates ask for, both flavours:
#    Expo SDK 51's prebuild template uses gradle-8.8-all, React Native 0.74's template gradle-8.6-all, and projects
#    may use -bin. With only -bin pre-warmed, every Expo build downloaded gradle-8.8-all.zip (220 MB) again.
#    The wrapper seed pattern makes the wrapper itself download and unpack each one, so the hashed directory and its
#    .ok marker in $GRADLE_USER_HOME/wrapper/dists are exactly what a project's gradlew looks for.
#    Newer templates (Expo 52+: 8.10.2-all, 8.13, 8.14.3, 9.x) are not pre-warmed: this image targets Expo SDK 51 /
#    RN 0.74, and each would add 150-220 MB. Such projects still build; they download their distribution.
RUN mkdir -p /tmp/.gradle/wrapper/dists /tmp/.npm-cache \
 && for VERSION in 8.8 8.6; do \
      echo "Pre-warming Gradle ${VERSION} (bin and all)..." \
      && curl -fsSL -o /tmp/gradle-${VERSION}-bin.zip https://services.gradle.org/distributions/gradle-${VERSION}-bin.zip \
      && unzip -q /tmp/gradle-${VERSION}-bin.zip -d /tmp \
      && for TYPE in bin all; do \
           mkdir -p /tmp/gradle-seed-${VERSION}-${TYPE} \
           && touch /tmp/gradle-seed-${VERSION}-${TYPE}/settings.gradle \
           && /tmp/gradle-${VERSION}/bin/gradle --no-daemon --project-dir /tmp/gradle-seed-${VERSION}-${TYPE} wrapper --gradle-version ${VERSION} --distribution-type ${TYPE} \
           && /tmp/gradle-seed-${VERSION}-${TYPE}/gradlew --no-daemon --version \
           && rm -rf /tmp/gradle-seed-${VERSION}-${TYPE} ; \
         done \
      && rm -rf /tmp/gradle-${VERSION} /tmp/gradle-${VERSION}-bin.zip ; \
    done

# 2. Warm the npm cache with the whole dependency tree of the Atomvs Expo template (~1,150 packages) by installing it
#    once. `npm cache add` of a few top-level packages left most of the tree to download on every build. Builds run
#    npm with --prefer-offline, so these come from the cache. The cache is in the image's read-only layers: it does not
#    count against the per-build disk limit; only new entries are written inside the container.
#    Also the Expo 51 prebuild template, which `expo prebuild` fetches through npm.
COPY rn-template/package.json /tmp/rn-template/package.json
RUN cd /tmp/rn-template \
 && npm install --no-audit --no-fund \
 && npm cache add expo-template-bare-minimum@sdk-51 \
 && cd / && rm -rf /tmp/rn-template

# 3. Create build mount point and set directory ownership for unprivileged sandbox user (1000:1000)
RUN mkdir -p /build \
 && chown -R 1000:1000 /tmp /build \
 && chmod -R u+rwX,go+rX /tmp /build

WORKDIR /build
USER 1000:1000

# 4. Pre-warm Gradle's build cache and transforms (DEC-10) with one release build of the Atomvs Expo template: our own
#    files only (rn-template/), never user code. It runs as the sandbox user, in /build like a real build (task cache
#    keys contain paths), with exactly the settings of a real build: the ABI init script (atomvs-abi.gradle, the same
#    text as ABI_INIT_SCRIPT in docker-sandbox.ts) and the gradle.properties lines of getBuildCommand. A test keeps them
#    in step (gradle-image-cache.test.ts).
#    Kept in the image (read-only layers, not counted against the per-build disk limit): caches/build-cache-1 (task
#    outputs: compiled Kotlin/Java, resources, dex of the libraries) and the transforms (unpacked/dexed AARs).
#    Removed: the project, Gradle's downloaded dependencies (modules-2: the shared read-only cache on the host serves
#    them, DEC-08), the ABI init script (each build brings its own), and everything else the build left in /tmp (only
#    .gradle and .npm-cache are kept): the template expo prebuild extracts (with its debug.keystore), ~/.android, ~/.expo,
#    Kotlin daemon logs. The step fails if any keystore is left in /tmp or /build, or if a cache entry is empty
#    (Gradle 8.8 fails a build on an unreadable entry instead of rebuilding it; real builds never write the cache).
#    Real builds read this cache with push=false (CACHE_INIT_SCRIPT); without it, or with a stale one, they just build.
COPY --chown=1000:1000 rn-template/package.json rn-template/app.json rn-template/App.tsx /build/
COPY --chown=1000:1000 rn-template/atomvs-abi.gradle /tmp/.gradle/init.d/atomvs-abi.gradle
RUN cd /build \
 && npm install --no-audit --no-fund --prefer-offline \
 && CI=1 EXPO_NO_TELEMETRY=1 npx expo prebuild --platform android --no-install \
 && npm install --no-audit --no-fund --prefer-offline \
 && printf "\norg.gradle.workers.max=3\n" >> android/gradle.properties \
 && printf "org.gradle.parallel=false\n" >> android/gradle.properties \
 && printf "org.gradle.daemon=false\n" >> android/gradle.properties \
 && printf "org.gradle.jvmargs=-Xmx2g\n" >> android/gradle.properties \
 && printf "reactNativeArchitectures=arm64-v8a\n" >> android/gradle.properties \
 && printf "org.gradle.caching=true\n" >> android/gradle.properties \
 && (cd android && NODE_ENV=production ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a) \
 && cd / \
 && rm -rf /build/* /build/.[!.]* \
 && rm -rf /tmp/.gradle/caches/modules-2 /tmp/.gradle/daemon /tmp/.gradle/.tmp /tmp/.gradle/native \
           /tmp/.gradle/kotlin-profile /tmp/.gradle/init.d/atomvs-abi.gradle /tmp/.gradle/gradle.properties \
           /tmp/.npm-cache/_logs \
 && find /tmp -mindepth 1 -maxdepth 1 ! -name .gradle ! -name .npm-cache -exec rm -rf {} + \
 && ! find /tmp /build -xdev \( -name "*.jks" -o -name "*.keystore" -o -name "*.p12" \) | grep . \
 && test -d /tmp/.gradle/caches/build-cache-1 \
 && ! find /tmp/.gradle/caches/build-cache-1 -type f -empty ! -name gc.properties | grep . \
 && du -sh /tmp/.gradle/caches/* 2>/dev/null | sort -h | tail -6
